# ===========================================
# 进程级共享配置（不含具体 bot 账号）
# bot 账号 / 管理员 / 传送点等见 config/bots/*.yaml
# ===========================================

# Minecraft 服务器
MC_HOST=play.example.com
MC_PORT=25565

# 微软登录凭证目录（各 bot 可用 account.profilesSubdir 分子目录）
MC_PROFILES_FOLDER=./mc-tokens

# 协议版本；false 表示自动探测
MC_VERSION=false

# Mineflayer 保活检测间隔（毫秒）
MC_CHECK_TIMEOUT=300000

# 消息队列
QUEUE_MAX_SIZE=100
QUEUE_DELAY_MS=1000

# 各 bot AstrBot 可共用的 API 密钥（也可在 bot yaml 的 astrbot.apiKey 覆盖）
API_KEY=your_api_key_here
